# Secret shared with Claude. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# MinIO / S3: the same bucket and credentials the Obsidian plugin uses.
# Full URL including scheme and port.
S3_ENDPOINT=https://minio.example.com:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=obsidian

PORT=8787

# Optional
# VAULT_READ_ONLY=true                       # only list/read/search tools are exposed
# VAULT_HIDDEN_PREFIXES=.obsidian,.trash     # never visible to Claude (this is the default)
# VAULT_WRITABLE_PREFIXES=Inbox,Claude       # when set, writes only allowed under these folders
# VAULT_MAX_READ_BYTES=1048576
# VAULT_AUTHOR=claude                        # stored as x-amz-meta-author on every write
